{
    "version": "0.2.0",
    "configurations": [
        {
            // Per Linux
            "name": "Poetry run debug",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/index.py",
            "console": "integratedTerminal",
            "args": [],
            "justMyCode": true
            // "env": {
            //     "PYTHONPATH": "${workspaceFolder}"
            // },
            // "python": "${config:python.defaultInterpreterPath}"
        },
        {
            // Per Windows
            "name": "Poetry run debug win",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/src/index.py",
            "console": "integratedTerminal",
            "args": [],
            "justMyCode": true,
            "env": {
                "PYTHONPATH": "${workspaceFolder}"
            },
            "python": "${workspaceFolder}/.venv/Scripts/python.exe"
        }
    ]
}